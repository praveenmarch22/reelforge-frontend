# Copy to .env.local to change.

# The mock API (MSW) answers every /api/v1 request in the browser, so the frontend
# runs with no backend. It is ON by default in development.
# Set to false once the real backend is running.
VITE_USE_MOCKS=true

# Base URL of the API. Leave as-is for mocks or a same-origin backend.
VITE_API_URL=/api/v1
